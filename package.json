    "@astrojs/sitemap": "3.7.4",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "1.4.4",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "roughjs": "4.6.6",
    "satori": "0.63.2",
    "typescript": "6.0.3"
  }
}
