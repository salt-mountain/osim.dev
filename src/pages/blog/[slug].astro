---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Comments from "../../components/Comments.astro";
import { heroSvg } from "../../lib/post-hero";
import "../../styles/global.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.date.toISOString().split("T")[0];
const filename = post.id + ".md";
const heroMarkup = heroSvg(post);
const heroInline =
  heroMarkup &&
  heroMarkup.replace(
    "<svg ",
    `<svg aria-label="${post.data.hero!.alt.replace(/"/g, "&quot;")}" `,
  );
---

<Layout
  title={`${post.data.title} — osim.dev`}
  description={post.data.description}
  image={
    post.data.ogImage ?? {
      src: `/og/blog/${post.id}.png`,
      alt: `${post.data.title} — a post on osim.dev`,
      generated: true,
    }
  }
>
  <div class="terminal-window">
    <!-- Window Chrome -->
    <div class="window-chrome">
      <div class="window-dots">
        <span class="window-dot window-dot--close"></span>
        <span class="window-dot window-dot--minimize"></span>
        <span class="window-dot window-dot--maximize"></span>
      </div>
      <span class="window-title">
        <span class="prompt__user">osim</span>
        <span class="prompt__separator">@</span>
        <span class="prompt__host">dev</span>
        <span class="prompt__separator">:</span>
        <span class="prompt__path">~/blog</span>
      </span>
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="Toggle theme"
      >
        light-mode
      </button>
    </div>

    <!-- Terminal Body -->
    <div class="terminal-body">
      <!-- Navigation -->
      <nav class="nav" aria-label="Primary">
        <div class="nav__prompt">
          <div class="powerline">
            <span class="powerline__seg powerline__seg--user">osim@dev</span>
            <span class="powerline__seg powerline__seg--path">~</span>
            <span class="powerline__seg powerline__seg--cmd">ls ./</span>
          </div>
        </div>
        <ul class="nav__links">
          <li class="nav__link">
            <a href="/">home</a>
          </li>
          <li class="nav__link">
            <a href="/#about">about</a>
          </li>
          <li class="nav__link">
            <a href="/#experience">experience</a>
          </li>
          <li class="nav__link">
            <a href="/#tech">tech</a>
          </li>
          <li class="nav__link nav__link--active">
            <a href="/blog">blog</a>
          </li>
          <li class="nav__link">
            <a href="/#contact">contact</a>
          </li>
          <li class="nav__link nav__link--resume">
            <a href="/resume.pdf" download>
              resume.pdf
            </a>
          </li>
        </ul>
      </nav>

      <!-- Post Header -->
      <section class="hero">
        <div class="powerline">
          <span class="powerline__seg powerline__seg--user">osim@dev</span>
          <span class="powerline__seg powerline__seg--path">~/blog</span>
          <span class="powerline__seg powerline__seg--cmd">cat {filename}</span>
          <span class="cursor" aria-hidden="true"></span>
        </div>
        <div class="post__meta">
          <span class="post__date">{formattedDate}</span>
        </div>
        <h1 class="post__title">{post.data.title}</h1>
      </section>

      <hr class="divider" />

      <!-- Post Body -->
      <article class="post__body">
        {heroInline ? (
          <figure class="diagram post__hero" set:html={heroInline} />
        ) : (
          post.data.hero && (
            <figure class="post__hero">
              <img src={post.data.hero.src} alt={post.data.hero.alt} />
            </figure>
          )
        )}
        <Content />
        <span class="cursor" aria-hidden="true"></span>
        {post.data.linkedin && (
          <p class="post__linkedin">
            <a
              href={post.data.linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >
              Discuss on LinkedIn &rarr;
            </a>
          </p>
        )}
      </article>

      {post.data.comments !== false && (
        <>
          <hr class="divider" />
          <Comments term={post.id} />
        </>
      )}

      <hr class="divider" />

      <!-- Back -->
      <div class="post__back">
        <div class="powerline">
          <span class="powerline__seg powerline__seg--user">osim@dev</span>
          <span class="powerline__seg powerline__seg--path">~/blog</span>
          <span class="powerline__seg powerline__seg--cmd">
            <a href="/blog" class="post__back-link">
              cd ~/blog
            </a>
          </span>
        </div>
        <a
          href="/blog"
          class="post__back-hint"
          tabindex="-1"
          aria-hidden="true"
        >
          # &larr; All posts
        </a>
      </div>

      <!-- Footer -->
      <footer class="footer">
        <div class="footer__prompt">
          <div class="powerline">
            <span class="powerline__seg powerline__seg--user">osim@dev</span>
            <span class="powerline__seg powerline__seg--path">~/blog</span>
            <span class="powerline__seg powerline__seg--cmd">
              <a href="/" class="post__back-link">
                cd ~
              </a>
            </span>
          </div>
        </div>
        <p>&copy; 2026 osim.dev</p>
      </footer>
    </div>
  </div>
</Layout>
